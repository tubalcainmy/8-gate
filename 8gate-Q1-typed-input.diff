+// ══════════════════════════════════════════════════════
+// Q1 — TYPED MONTHLY SPEND FIELD
+// Real number instead of a band select, so the ROI result (payback
+// period, 20-year savings, etc.) is calculated from what the homeowner
+// actually told us rather than a band midpoint.
+// ══════════════════════════════════════════════════════
+const SPEND_MIN = 0;
+const SPEND_MAX = 2000000; // sanity ceiling — catches fat-finger typos (extra zero, etc.)
+
+function wireSpendInput(){
+  const input = document.getElementById('q1-spend-input');
+  const row = input.closest('.spend-input-row');
+  const error = document.getElementById('q1-spend-error');
+  const nextBtn = document.getElementById('q1-next');
+
+  function validate(showError){
+    const raw = input.value.trim();
+    if (raw === '') {
+      if (showError) { error.textContent = 'Please enter your monthly spend.'; error.classList.add('show'); row.classList.add('spend-error'); }
+      nextBtn.disabled = true;
+      return null;
+    }
+    const val = Number(raw);
+    if (!Number.isFinite(val) || /[^0-9.]/.test(raw)) {
+      if (showError) { error.textContent = 'Numbers only, please — no letters or symbols.'; error.classList.add('show'); row.classList.add('spend-error'); }
+      nextBtn.disabled = true;
+      return null;
+    }
+    if (val < SPEND_MIN) {
+      if (showError) { error.textContent = "That can't be negative."; error.classList.add('show'); row.classList.add('spend-error'); }
+      nextBtn.disabled = true;
+      return null;
+    }
+    if (val > SPEND_MAX) {
+      if (showError) { error.textContent = 'That seems too high — check the number and try again.'; error.classList.add('show'); row.classList.add('spend-error'); }
+      nextBtn.disabled = true;
+      return null;
+    }
+    error.classList.remove('show');
+    row.classList.remove('spend-error');
+    nextBtn.disabled = false;
+    return val;
+  }
+
+  input.addEventListener('input', () => {
+    const val = validate(false); // live: only clear errors, don't nag while typing
+    state.answers.q1 = val !== null ? { val: val, spend: val } : null;
+  });
+  input.addEventListener('blur', () => { validate(true); });
+}
